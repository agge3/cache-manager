#include <gtest/gtest.h>
#include <oneapi/tbb/concurrent_unordered_map.h>
#include <tbb/concurrent_unordered_map.h>
#include <chrono>
#include <random>
#include <thread>
#include <vector>
#include <iostream>
#include <set>
#include <mutex>
#include <atomic>
#include <iomanip>

#include "concurrent-list.hpp"

namespace cm {

// Performance tracking structure
struct PerfMetrics {
    std::chrono::milliseconds totalTime;
    long long insertCount = 0;
    long long removeCount = 0;
    long long insertSuccessCount = 0;
    long long removeSuccessCount = 0;
};

template <typename T>
class ConcurrentListTest : public ::testing::Test {
protected:
    T list;
    int initialSize = 1000;
    int opsPerThread = 500;
    int numThreads = 8;
    PerfMetrics metrics;
    std::set<int> expectedValues;
    std::mutex expectedMutex;

	void populateList(int n) {
       std::mt19937 rng(std::chrono::steady_clock::now().time_since_epoch().count());
       std::uniform_int_distribution<int> dist(1, n * 10);
       for (int i = 0; i < n; ++i) {
           int val = dist(rng);
           if (this->list.insert(val)) {  // Only count successful inserts
               std::lock_guard<std::mutex> lock(this->expectedMutex);
               this->expectedValues.insert(val);
           }
       }
   }

    void PrintMetrics(const std::string& implName) {
        std::cout << "\n" << std::string(70, '=') << "\n";
        std::cout << "Implementation: " << implName << "\n";
        std::cout << std::string(70, '=') << "\n";
        std::cout << std::fixed << std::setprecision(2);
        std::cout << "Total time: " << metrics.totalTime.count() << " ms\n";
        std::cout << "Insert operations: " << metrics.insertCount
                  << " (success: " << metrics.insertSuccessCount << ")\n";
        std::cout << "Remove operations: " << metrics.removeCount
                  << " (success: " << metrics.removeSuccessCount << ")\n";
        double insertSuccessRate = metrics.insertCount > 0
            ? (100.0 * metrics.insertSuccessCount / metrics.insertCount) : 0;
        double removeSuccessRate = metrics.removeCount > 0
            ? (100.0 * metrics.removeSuccessCount / metrics.removeCount) : 0;
        std::cout << "Insert success rate: " << insertSuccessRate << "%\n";
        std::cout << "Remove success rate: " << removeSuccessRate << "%\n";
        std::cout << "Final list size: " << list.size() << "\n";
        std::cout << "Expected size: " << expectedValues.size() << "\n";
        std::cout << std::string(70, '=') << "\n";
    }

    void ResetMetrics() {
        metrics = PerfMetrics();
        expectedValues.clear();
    }
};

using Implementations = ::testing::Types<
    HandOverHandList<int>,
    CoarseGrainedList<int>,
    GroupedFineGrainedList<int>
>;
TYPED_TEST_SUITE(ConcurrentListTest, Implementations);

// Test 1: Basic functionality with population
TYPED_TEST(ConcurrentListTest, PopulationAndBasicOps) {
    this->populateList(this->initialSize);
    EXPECT_EQ(this->list.size(), this->initialSize);

    // Verify all inserted values are findable
    {
        std::lock_guard<std::mutex> lock(this->expectedMutex);
        for (int val : this->expectedValues) {
            EXPECT_TRUE(this->list.contains(val))
                << "Value " << val << " should be in list after population";
        }
    }
}

// Test 2: Correctness under concurrent load with tracked operations
TYPED_TEST(ConcurrentListTest, ConcurrentRandomInsertRemoveWithVerification) {
    this->ResetMetrics();
    this->populateList(this->initialSize);

    auto start = std::chrono::steady_clock::now();
    std::vector<std::thread> threads;

    for (int t = 0; t < this->numThreads; ++t) {
        threads.emplace_back([&, t]() {
            std::mt19937 rng(t + std::chrono::steady_clock::now().time_since_epoch().count());
            std::uniform_int_distribution<int> dist(1, this->initialSize * 2);

            for (int i = 0; i < this->opsPerThread; ++i) {
                int val = dist(rng);

                if (val % 2 == 0) {
                    // Insert operation
                    bool success = this->list.insert(val);
                    this->metrics.insertCount++;
                    if (success) {
                        this->metrics.insertSuccessCount++;
                        {
                            std::lock_guard<std::mutex> lock(this->expectedMutex);
                            this->expectedValues.insert(val);
                        }
                    }
                } else {
                    // Remove operation
                    bool success = this->list.remove(val);
                    this->metrics.removeCount++;
                    if (success) {
                        this->metrics.removeSuccessCount++;
                        {
                            std::lock_guard<std::mutex> lock(this->expectedMutex);
                            this->expectedValues.erase(val);
                        }
                    }
                }
            }
        });
    }

    for (auto &th : threads) th.join();
    auto end = std::chrono::steady_clock::now();
    this->metrics.totalTime = std::chrono::duration_cast<std::chrono::milliseconds>(end - start);

    // Critical: Verify final state matches expected
    EXPECT_EQ(this->list.size(), this->expectedValues.size())
        << "Final list size must match expected values";

    {
        std::lock_guard<std::mutex> lock(this->expectedMutex);
        for (int val : this->expectedValues) {
            EXPECT_TRUE(this->list.contains(val))
                << "Value " << val << " should be in final list";
        }
    }

    this->PrintMetrics(typeid(TypeParam).name());
}

// Test 3: High contention scenario - all threads operate on same range
TYPED_TEST(ConcurrentListTest, HighContentionSameRange) {
    this->ResetMetrics();
    int contentionRange = 100;
    for (int i = 0; i < contentionRange; ++i) {
        this->list.insert(i);
        this->expectedValues.insert(i);
    }

    auto start = std::chrono::steady_clock::now();
    std::vector<std::thread> threads;

    for (int t = 0; t < this->numThreads; ++t) {
        threads.emplace_back([&, t]() {
            std::mt19937 rng(t);
            std::uniform_int_distribution<int> dist(0, contentionRange - 1);

            for (int i = 0; i < this->opsPerThread; ++i) {
                int val = dist(rng);
                if (rng() % 2 == 0) {
                    bool success = this->list.insert(val);
                    this->metrics.insertCount++;
                    if (success) {
                        this->metrics.insertSuccessCount++;
                        {
                            std::lock_guard<std::mutex> lock(this->expectedMutex);
                            this->expectedValues.insert(val);
                        }
                    }
                } else {
                    bool success = this->list.remove(val);
                    this->metrics.removeCount++;
                    if (success) {
                        this->metrics.removeSuccessCount++;
                        {
                            std::lock_guard<std::mutex> lock(this->expectedMutex);
                            this->expectedValues.erase(val);
                        }
                    }
                }
            }
        });
    }

    for (auto &th : threads) th.join();
    auto end = std::chrono::steady_clock::now();
    this->metrics.totalTime = std::chrono::duration_cast<std::chrono::milliseconds>(end - start);

    EXPECT_EQ(this->list.size(), this->expectedValues.size())
        << "Final list size must match expected values under high contention";
    {
        std::lock_guard<std::mutex> lock(this->expectedMutex);
        for (int val : this->expectedValues) {
            EXPECT_TRUE(this->list.contains(val));
        }
    }

    this->PrintMetrics(std::string(typeid(TypeParam).name()) + " [HIGH CONTENTION]");
}

// Test 4: Mostly inserts with few removes
TYPED_TEST(ConcurrentListTest, InsertHeavyWorkload) {
    this->ResetMetrics();
    this->populateList(this->initialSize);

    auto start = std::chrono::steady_clock::now();
    std::vector<std::thread> threads;

    for (int t = 0; t < this->numThreads; ++t) {
        threads.emplace_back([&, t]() {
            std::mt19937 rng(t + std::chrono::steady_clock::now().time_since_epoch().count());
            std::uniform_int_distribution<int> dist(this->initialSize, this->initialSize * 100);

            for (int i = 0; i < this->opsPerThread; ++i) {
                int val = dist(rng);
                bool success = this->list.insert(val);
                this->metrics.insertCount++;
                if (success) {
                    this->metrics.insertSuccessCount++;
                    {
                        std::lock_guard<std::mutex> lock(this->expectedMutex);
                        this->expectedValues.insert(val);
                    }
                }
            }
        });
    }

    for (auto &th : threads) th.join();
    auto end = std::chrono::steady_clock::now();
    this->metrics.totalTime = std::chrono::duration_cast<std::chrono::milliseconds>(end - start);

    EXPECT_EQ(this->list.size(), this->expectedValues.size());
    EXPECT_GT(this->list.size(), (size_t)this->initialSize);

    this->PrintMetrics(std::string(typeid(TypeParam).name()) + " [INSERT HEAVY]");
}

// Test 5: Mostly removes with few inserts
TYPED_TEST(ConcurrentListTest, RemoveHeavyWorkload) {
    this->ResetMetrics();
    this->populateList(this->initialSize * 2);

    auto start = std::chrono::steady_clock::now();
    std::vector<std::thread> threads;

    for (int t = 0; t < this->numThreads; ++t) {
        threads.emplace_back([&, t]() {
            std::mt19937 rng(t + std::chrono::steady_clock::now().time_since_epoch().count());
            std::uniform_int_distribution<int> dist(1, this->initialSize * 2);

            for (int i = 0; i < this->opsPerThread; ++i) {
                int val = dist(rng);
                bool success = this->list.remove(val);
                this->metrics.removeCount++;
                if (success) {
                    this->metrics.removeSuccessCount++;
                    {
                        std::lock_guard<std::mutex> lock(this->expectedMutex);
                        this->expectedValues.erase(val);
                    }
                }
            }
        });
    }

    for (auto &th : threads) th.join();
    auto end = std::chrono::steady_clock::now();
    this->metrics.totalTime = std::chrono::duration_cast<std::chrono::milliseconds>(end - start);

    EXPECT_EQ(this->list.size(), this->expectedValues.size());
    EXPECT_LT(this->list.size(), (size_t)(this->initialSize * 2));

    this->PrintMetrics(std::string(typeid(TypeParam).name()) + " [REMOVE HEAVY]");
}

// Test 6: Edge cases - empty list, single element
TYPED_TEST(ConcurrentListTest, EdgeCasesEmptyAndSingle) {
    this->ResetMetrics();
    EXPECT_EQ(this->list.size(), 0);
    EXPECT_FALSE(this->list.contains(999));
    EXPECT_FALSE(this->list.remove(999));

    bool inserted = this->list.insert(42);
    EXPECT_TRUE(inserted);
    EXPECT_EQ(this->list.size(), 1);
    EXPECT_TRUE(this->list.contains(42));

    bool removed = this->list.remove(42);
    EXPECT_TRUE(removed);
    EXPECT_EQ(this->list.size(), 0);
}

// Test 7: Stress test - maximum concurrency
TYPED_TEST(ConcurrentListTest, StressTestMaxConcurrency) {
    this->ResetMetrics();
    int stressThreads = 16;
    int stressOpsPerThread = 1000;

    this->populateList(this->initialSize);

    auto start = std::chrono::steady_clock::now();
    std::vector<std::thread> threads;

    for (int t = 0; t < stressThreads; ++t) {
        threads.emplace_back([&, t]() {
            std::mt19937 rng(t + std::chrono::steady_clock::now().time_since_epoch().count());
            std::uniform_int_distribution<int> dist(1, this->initialSize * 3);

            for (int i = 0; i < stressOpsPerThread; ++i) {
                int val = dist(rng);
                if (rng() % 2 == 0) {
                    this->list.insert(val);
                    this->metrics.insertCount++;
                } else {
                    this->list.remove(val);
                    this->metrics.removeCount++;
                }
            }
        });
    }

    for (auto &th : threads) th.join();
    auto end = std::chrono::steady_clock::now();
    this->metrics.totalTime = std::chrono::duration_cast<std::chrono::milliseconds>(end - start);

    // Just verify it didn't crash and size is reasonable
    EXPECT_GE(this->list.size(), 0);
    EXPECT_LE(this->list.size(), (size_t)(this->initialSize * 4));

    this->PrintMetrics(std::string(typeid(TypeParam).name()) + " [STRESS TEST]");
}

// Test 8: List consistency validation
TYPED_TEST(ConcurrentListTest, ListConsistency) {
    this->ResetMetrics();
    this->populateList(this->initialSize);
    
    auto start = std::chrono::steady_clock::now();
    std::vector<std::thread> threads;

    for (int t = 0; t < this->numThreads; ++t) {
        threads.emplace_back([&, t]() {
            std::mt19937 rng(t + std::chrono::steady_clock::now().time_since_epoch().count());
            std::uniform_int_distribution<int> dist(1, this->initialSize * 2);

            for (int i = 0; i < this->opsPerThread; ++i) {
                int val = dist(rng);
                if (rng() % 2 == 0) {
                    this->list.insert(val);
                } else {
                    this->list.remove(val);
                }
            }
        });
    }

    for (auto &th : threads) th.join();
    auto end = std::chrono::steady_clock::now();
    this->metrics.totalTime = std::chrono::duration_cast<std::chrono::milliseconds>(end - start);

    // Verify list structure is valid
    EXPECT_TRUE(this->list.isConsistent())
        << "List structure should be consistent after concurrent operations";

    this->PrintMetrics(std::string(typeid(TypeParam).name()) + " [CONSISTENCY CHECK]");
}

int main(int argc, char **argv) {
	auto m = tbb::concurrent_unordered_map<int, int>;

	return 0;
}

