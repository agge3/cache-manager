#pragma once

#include <thread>
#include <vector>

template <typename T>
std::vector<T> generateDistr() {
}

template <typename T>
struct TestCfg {
	using TestFn = std::function<void(const T&)>
	size_t threads;
	std::vector<T> distr
	TestFn fn;
	TestCfg(size_t threads, TestFn fn) : threads(threads), fn(fn) {
		distr = generateDistr<T>();
	}
};

template <typename T>
class TestRunner {
public:
	template <typename... Cfgs>
	TestRunner(Cfgs ...cfgs, Fns ...fns) {
		(cfgs.push_back(cfgs), ...);
	}

	void run() {
		for (auto &cfg : cfgs) {
			runCfg(cfg);
		}
	}

	void expect() {
	}
private:
	void runCfg(const TestCfg<T>& cfg) {
		std::vector<std::thread> pool;

		for (auto i = 0; i < cfg.threads; ++i) {
			pool.emplace_back([&, i]() {
				cfg.fn(cfg.dist);
			});
		}

		for (auto &t : pool) {
			t.join();
		}
	}

	std::vector<std::thread> pool;
	std::vector<TestCfg<T>> cfgs;
};
